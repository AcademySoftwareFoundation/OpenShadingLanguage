OpenShadingLanguage 1.00
shader variadic_too_few
oparam	float	result	0		%read{2147483647,-1} %write{2,3}
global	float	u	%read{0,3} %write{2147483647,-1}
const	float	$const1	0.5		%read{0,2} %write{2147483647,-1}
temp	int	$tmp1	%read{1,1} %write{0,0}
code ___main___
	gt		$tmp1 u $const1 	%argrw{"wrr"}
	if		$tmp1 3 4 	%argrw{"r"}
	printf		%argrw{""}
	assign		result u 	%argrw{"wr"}
	end
