surface
diffuse_textured
(
    string texture_path = "maps/uvgrid.exr"
        [[ string description = "Base color texture" ]]
)
{
    color base = texture(texture_path, u, 1 - v,
                        "colorspace", "ACEScg");

    base = clamp(base, color(0.0), color(1.0));

    normal Nn = normalize(N);
    Ci = base * diffuse(Nn);
}